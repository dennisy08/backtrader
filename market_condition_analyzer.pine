// ╔══════════════════════════════════════════════════════════════════════════╗
// ║        MARKET CONDITION ANALYZER [PRO] — Directional Probability        ║
// ║                                                                          ║
// ║  8-Factor confluence scoring system. Each factor returns -1 to +1.      ║
// ║  The composite score converts to a 0–100% bullish probability.          ║
// ║                                                                          ║
// ║  FACTORS (research-ranked by statistical backing):                       ║
// ║   1. Volume Confirmation  — strongest factor, 69% persistence rate      ║
// ║   2. VWAP Position        — institutional intraday reference level       ║
// ║   3. Dual EMA Trend       — 9/21 cross, strongest as a filter            ║
// ║   4. Opening Range (ORB)  — 52–89% edge depending on filters             ║
// ║   5. Gap / Opening        — gap direction as momentum context            ║
// ║   6. PD Close Position    — where prev day closed in its range           ║
// ║   7. PD Candle Structure  — bull/bear candle body momentum               ║
// ║   8. RSI Momentum         — overbought/oversold confirmation             ║
// ║                                                                          ║
// ║  3+ factors aligning = 65–75% directional accuracy (per research)       ║
// ║  Plots: PDH, PDL, PDC, PD Mid, OR H/L, VWAP, Fast EMA, Slow EMA        ║
// ╚══════════════════════════════════════════════════════════════════════════╝

//@version=5
indicator("Market Condition Analyzer [Pro]", shorttitle="MCA Pro", overlay=true,
          max_lines_count=20, max_labels_count=10)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════
i_showPD    = input.bool(true,          "Show Prev Day Levels",       group="Display")
i_showOR    = input.bool(true,          "Show Opening Range",         group="Display")
i_showVWAP  = input.bool(true,          "Show VWAP",                  group="Display")
i_showEMA   = input.bool(true,          "Show EMAs",                  group="Display")
i_showTable = input.bool(true,          "Show Probability Table",     group="Display")
i_tblPos    = input.string("top_right", "Table Position",             group="Display",
               options=["top_right","top_left","bottom_right","bottom_left"])

i_orMins    = input.int(30,             "Opening Range (minutes)",    group="Session",     minval=5,  maxval=120)

i_fastEMA   = input.int(9,              "Fast EMA Length",            group="Indicators",  minval=3)
i_slowEMA   = input.int(21,             "Slow EMA Length",            group="Indicators",  minval=5)
i_volLen    = input.int(20,             "Volume MA Length",           group="Indicators",  minval=5)
i_rsiLen    = input.int(14,             "RSI Length",                 group="Indicators",  minval=3)
i_rsiOB     = input.int(60,             "RSI Bullish Threshold",      group="Indicators",  minval=50, maxval=80)
i_rsiOS     = input.int(40,             "RSI Bearish Threshold",      group="Indicators",  minval=20, maxval=50)

i_bullCol   = input.color(#00C853,      "Bullish Color",              group="Colors")
i_bearCol   = input.color(#D50000,      "Bearish Color",              group="Colors")
i_neutCol   = input.color(#FFD600,      "Neutral Color",              group="Colors")

// ═══════════════════════════════════════════════════════════════════════════
// PREVIOUS DAY DATA  (confirmed, no repainting)
// ═══════════════════════════════════════════════════════════════════════════
[pdH, pdL, pdC, pdO] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_on)

pdRange     = pdH - pdL
pdMid       = (pdH + pdL) * 0.5
pdClosePos  = pdRange > 0.0 ? (pdC - pdL) / pdRange : 0.5
pdBody      = pdC - pdO
pdBodyRatio = pdRange > 0.0 ? math.abs(pdBody) / pdRange : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// TODAY'S OPEN + OPENING RANGE TRACKING
// ═══════════════════════════════════════════════════════════════════════════
isNewDay = ta.change(time("D")) != 0

var float todayOpen = na
var float orHigh    = na
var float orLow     = na
var bool  orDone    = false
var int   dayStart  = na

if isNewDay or barstate.isfirst
    todayOpen := open
    orHigh    := high
    orLow     := low
    orDone    := false
    dayStart  := time

if not orDone and not na(dayStart)
    minsElapsed = (time - dayStart) / 60000
    if minsElapsed <= i_orMins
        orHigh := math.max(nz(orHigh, high), high)
        orLow  := math.min(nz(orLow,  low),  low)
    else
        orDone := true

orMid = (nz(orHigh) + nz(orLow)) * 0.5

// ═══════════════════════════════════════════════════════════════════════════
// TECHNICAL INDICATORS
// ═══════════════════════════════════════════════════════════════════════════
fastEMA = ta.ema(close, i_fastEMA)
slowEMA = ta.ema(close, i_slowEMA)
vwap    = ta.vwap
volMA   = ta.sma(volume, i_volLen)
rsi     = ta.rsi(close, i_rsiLen)

// ═══════════════════════════════════════════════════════════════════════════
// SCORING FACTORS  — each returns a value in [-1.0, +1.0]
//   +1.0  = strongly bullish      -1.0 = strongly bearish
//   +0.5  = mildly bullish        -0.5 = mildly bearish
//    0.0  = neutral / not enough data
// ═══════════════════════════════════════════════════════════════════════════

// ── F1: Volume Confirmation (STRONGEST — 69% persistence per research) ────
//   High volume (>120% avg) in the direction of the candle confirms move.
//   Normal volume = neutral (no confirmation either way).
f_vol = volume > volMA * 1.2 ?
        (close > open ?  1.0 : close < open ? -1.0 : 0.0) :
        0.0

// ── F2: VWAP Position (institutional intraday reference) ──────────────────
//   Price >0.2% above VWAP = institutions accumulating above fair value
//   Price <0.2% below VWAP = institutions distributing below fair value
f_vwap = close > vwap * 1.002 ?  1.0 :
         close < vwap * 0.998 ? -1.0 :
         close > vwap          ?  0.5 :
         close < vwap          ? -0.5 : 0.0

// ── F3: Dual EMA Trend — 9/21 Cross (strongest as filter) ─────────────────
//   Full alignment: fast > slow AND price > fast = strong trend
//   Partial:  price above slow EMA only = mild trend
emaAligned   = fastEMA > slowEMA and close > fastEMA
emaBearAlign = fastEMA < slowEMA and close < fastEMA
f_trend = emaAligned   ?  1.0 :
          emaBearAlign ? -1.0 :
          close > slowEMA ?  0.5 :
          close < slowEMA ? -0.5 : 0.0

// ── F4: Opening Range Position (ORB — 52–89% edge with filters) ───────────
//   Broke above OR High = bull breakout confirmed
//   Inside upper half   = mild bull pressure
//   Inside lower half   = mild bear pressure
//   Broke below OR Low  = bear breakdown confirmed
//   OR still forming    = neutral
f_or = not orDone     ?  0.0 :
       close > orHigh ?  1.0 :
       close < orLow  ? -1.0 :
       close > orMid  ?  0.5 :
       close < orMid  ? -0.5 : 0.0

// ── F5: Gap / Opening Context ─────────────────────────────────────────────
//   Gap Up above PDH  = strong overnight bullish momentum
//   Open above PDC    = mild bullish overnight sentiment
//   Open below PDC    = mild bearish overnight sentiment
//   Gap Down below PDL = strong overnight bearish momentum
f_gap = todayOpen > pdH ?  1.0 :
        todayOpen < pdL ? -1.0 :
        todayOpen > pdC ?  0.5 :
        todayOpen < pdC ? -0.5 : 0.0

// ── F6: Previous Day Close Position in Range ──────────────────────────────
//   Top 33% = buyers controlled the session close  → bullish carry-forward
//   Bot 33% = sellers controlled the session close → bearish carry-forward
f_pdClose = pdClosePos >= 0.67 ?  1.0 :
            pdClosePos <= 0.33 ? -1.0 : 0.0

// ── F7: Previous Day Candle Structure ─────────────────────────────────────
//   Strong directional candle (body ≥60% of range) = momentum carries
f_pdCandle = pdBody > 0.0 and pdBodyRatio >= 0.60 ?  1.0 :
             pdBody < 0.0 and pdBodyRatio >= 0.60 ? -1.0 :
             pdBody > 0.0                          ?  0.5 :
             pdBody < 0.0                          ? -0.5 : 0.0

// ── F8: RSI Momentum ──────────────────────────────────────────────────────
//   RSI ≥ bullish threshold = bullish momentum confirmed
//   RSI ≤ bearish threshold = bearish momentum confirmed
//   RSI 55–60 or 40–45     = mild directional lean
f_rsi = rsi >= i_rsiOB ?  1.0 :
        rsi <= i_rsiOS ? -1.0 :
        rsi >  55      ?  0.5 :
        rsi <  45      ? -0.5 : 0.0

// ═══════════════════════════════════════════════════════════════════════════
// COMPOSITE PROBABILITY SCORE
//   Range: -1.0 (all 8 factors bearish) to +1.0 (all 8 factors bullish)
//   Converts to 0–100% bull probability
// ═══════════════════════════════════════════════════════════════════════════
totalScore = (f_vol + f_vwap + f_trend + f_or + f_gap + f_pdClose + f_pdCandle + f_rsi) / 8.0

bullProb = int(math.round((totalScore + 1.0) / 2.0 * 100))
bearProb = 100 - bullProb

// Bias thresholds: ≥65% = Bullish, ≤35% = Bearish (matches 65–75% research threshold)
bias    = bullProb >= 65 ? "BULLISH" : bullProb <= 35 ? "BEARISH" : "NEUTRAL"
biasCol = bullProb >= 65 ? i_bullCol : bullProb <= 35 ? i_bearCol : i_neutCol

// ═══════════════════════════════════════════════════════════════════════════
// PLOT KEY LEVELS
// ═══════════════════════════════════════════════════════════════════════════
plot(i_showPD   ? pdH     : na, "PDH",      color=color.new(#ef5350, 20), linewidth=1)
plot(i_showPD   ? pdL     : na, "PDL",      color=color.new(#26a69a, 20), linewidth=1)
plot(i_showPD   ? pdC     : na, "PDC",      color=color.new(#b0bec5, 40), linewidth=1, style=plot.style_stepline)
plot(i_showPD   ? pdMid   : na, "PD Mid",   color=color.new(#607d8b, 50), linewidth=1)
plot(i_showOR   ? orHigh  : na, "OR High",  color=color.new(#ffa726, 10), linewidth=1)
plot(i_showOR   ? orLow   : na, "OR Low",   color=color.new(#42a5f5, 10), linewidth=1)
plot(i_showVWAP ? vwap    : na, "VWAP",     color=color.new(#e91e63, 20), linewidth=2)
plot(i_showEMA  ? fastEMA : na, "Fast EMA", color=color.new(#ffeb3b, 30), linewidth=1)
plot(i_showEMA  ? slowEMA : na, "Slow EMA", color=color.new(#ff9800, 30), linewidth=1)

// ═══════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS — Signal label & color from factor score
// ═══════════════════════════════════════════════════════════════════════════
f_sigStr(s) =>
    s >= 0.75  ? "▲▲ STRONG BULL" :
    s >= 0.25  ? "▲  BULLISH"     :
    s <= -0.75 ? "▼▼ STRONG BEAR" :
    s <= -0.25 ? "▼  BEARISH"     :
                 "─  NEUTRAL"

f_sigCol(s) =>
    s > 0.0 ? i_bullCol : s < 0.0 ? i_bearCol : i_neutCol

// ═══════════════════════════════════════════════════════════════════════════
// PROBABILITY TABLE
// ═══════════════════════════════════════════════════════════════════════════
tPos = i_tblPos == "top_right"    ? position.top_right    :
       i_tblPos == "top_left"     ? position.top_left     :
       i_tblPos == "bottom_right" ? position.bottom_right :
       position.bottom_left

var table tbl = table.new(tPos, 3, 17,
                  bgcolor      = color.new(color.black, 10),
                  border_width = 1,
                  border_color = color.new(color.gray, 60),
                  frame_width  = 2,
                  frame_color  = color.new(color.gray, 30))

if barstate.islast and i_showTable
    C_HEAD = color.new(#1a237e,      5)
    C_BIAS = color.new(#263238,      5)
    C_COLS = color.new(#1e2830,     20)
    C_ROW  = color.new(color.black, 20)
    C_FOOT = color.new(#1b2631,     10)

    // ── Row 0: Title ──────────────────────────────────────────────────────
    tfLabel = timeframe.in_seconds() >= 86400 ? timeframe.period : timeframe.period + "m"
    table.cell(tbl, 0, 0, "MARKET CONDITION ANALYZER [PRO]",
               text_color=color.white,  text_size=size.small, bgcolor=C_HEAD)
    table.cell(tbl, 1, 0, "",
               text_color=color.white,  text_size=size.small, bgcolor=C_HEAD)
    table.cell(tbl, 2, 0, syminfo.ticker + "  " + tfLabel,
               text_color=color.yellow, text_size=size.small, bgcolor=C_HEAD)

    // ── Row 1: Overall Bias ───────────────────────────────────────────────
    table.cell(tbl, 0, 1, "OVERALL BIAS",
               text_color=color.silver, text_size=size.small, bgcolor=C_BIAS)
    table.cell(tbl, 1, 1, bias,
               text_color=biasCol,      text_size=size.normal, bgcolor=C_BIAS)
    table.cell(tbl, 2, 1, str.tostring(bullProb) + "% BULL  " + str.tostring(bearProb) + "% BEAR",
               text_color=biasCol,      text_size=size.tiny,   bgcolor=C_BIAS)

    // ── Row 2: Column headers ─────────────────────────────────────────────
    table.cell(tbl, 0, 2, "FACTOR  (8 total)",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)
    table.cell(tbl, 1, 2, "READING",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)
    table.cell(tbl, 2, 2, "SIGNAL",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)

    // ── Row 3: Volume Confirmation (F1 — strongest) ───────────────────────
    volPct = math.round(volume / volMA * 100)
    volLbl = volume > volMA * 1.2 ?
             (close > open ?
              "HIGH Vol ▲  (" + str.tostring(volPct) + "%)" :
              "HIGH Vol ▼  (" + str.tostring(volPct) + "%)") :
             "Normal Vol  (" + str.tostring(volPct) + "%)"
    table.cell(tbl, 0, 3, "Volume Confirm",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 3, volLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 3, f_sigStr(f_vol),
               text_color=f_sigCol(f_vol), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 4: VWAP (F2) ──────────────────────────────────────────────────
    vwapDist = math.round((close - vwap) / vwap * 100, 2)
    vwapLbl  = close > vwap ?
               "Above VWAP +" + str.tostring(vwapDist) + "%" :
               "Below VWAP " + str.tostring(vwapDist) + "%"
    table.cell(tbl, 0, 4, "VWAP",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 4, vwapLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 4, f_sigStr(f_vwap),
               text_color=f_sigCol(f_vwap), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 5: Dual EMA Trend (F3) ────────────────────────────────────────
    trendLbl = emaAligned   ? "9+21 EMA  Bull (full align)" :
               emaBearAlign ? "9+21 EMA  Bear (full align)" :
               close > slowEMA ? "Above EMA21 (partial)" : "Below EMA21 (partial)"
    table.cell(tbl, 0, 5, "Dual EMA Trend",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 5, trendLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 5, f_sigStr(f_trend),
               text_color=f_sigCol(f_trend), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 6: Opening Range (F4) ─────────────────────────────────────────
    orLbl = not orDone     ? "Forming (" + str.tostring(i_orMins) + " min)..." :
            close > orHigh ? "Broke ABOVE OR — Bull"     :
            close < orLow  ? "Broke BELOW OR — Bear"     :
            close > orMid  ? "Inside — Upper Half"        :
                              "Inside — Lower Half"
    table.cell(tbl, 0, 6, "Open Range (" + str.tostring(i_orMins) + "m)",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 6, orLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 6, f_sigStr(f_or),
               text_color=f_sigCol(f_or), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 7: Gap / Open (F5) ────────────────────────────────────────────
    gapLbl = todayOpen > pdH ? "Gap Up  (above PDH)"  :
             todayOpen < pdL ? "Gap Down (below PDL)" :
             todayOpen > pdC ? "Open > Prev Close"    :
                               "Open < Prev Close"
    table.cell(tbl, 0, 7, "Gap / Open",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 7, gapLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 7, f_sigStr(f_gap),
               text_color=f_sigCol(f_gap), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 8: PD Close Position (F6) ────────────────────────────────────
    pdCLbl = pdClosePos >= 0.67 ? "Top 33%  — Bull Close"  :
             pdClosePos <= 0.33 ? "Bot 33%  — Bear Close"  :
                                  "Mid Range — Neutral"
    table.cell(tbl, 0, 8, "PD Close Pos",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 8, pdCLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 8, f_sigStr(f_pdClose),
               text_color=f_sigCol(f_pdClose), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 9: PD Candle Structure (F7) ──────────────────────────────────
    pdCandleLbl = pdBody > 0.0 and pdBodyRatio >= 0.60 ?
                  "Strong Bull  (" + str.tostring(math.round(pdBodyRatio * 100)) + "% body)" :
                  pdBody < 0.0 and pdBodyRatio >= 0.60 ?
                  "Strong Bear  (" + str.tostring(math.round(pdBodyRatio * 100)) + "% body)" :
                  pdBody > 0.0 ? "Mild Bull Candle"  :
                  pdBody < 0.0 ? "Mild Bear Candle"  :
                                  "Doji / Neutral"
    table.cell(tbl, 0, 9, "PD Candle",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 9, pdCandleLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 9, f_sigStr(f_pdCandle),
               text_color=f_sigCol(f_pdCandle), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 10: RSI Momentum (F8) ─────────────────────────────────────────
    rsiLbl = str.tostring(math.round(rsi, 1)) +
             (rsi >= i_rsiOB ? "  — Bull Momentum"  :
              rsi <= i_rsiOS ? "  — Bear Momentum"  :
              rsi > 55       ? "  — Mild Bull"      :
              rsi < 45       ? "  — Mild Bear"      :
                                "  — Neutral")
    table.cell(tbl, 0, 10, "RSI(" + str.tostring(i_rsiLen) + ")",
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 1, 10, rsiLbl,
               text_color=color.silver, text_size=size.tiny, bgcolor=C_ROW)
    table.cell(tbl, 2, 10, f_sigStr(f_rsi),
               text_color=f_sigCol(f_rsi), text_size=size.tiny, bgcolor=C_ROW)

    // ── Row 11: Probability Bar ───────────────────────────────────────────
    barFill = int(math.round(bullProb / 10.0))
    barStr  = ""
    for i = 0 to 9
        barStr := barStr + (i < barFill ? "█" : "░")
    table.cell(tbl, 0, 11, "Bear " + str.tostring(bearProb) + "%",
               text_color=i_bearCol, text_size=size.tiny,  bgcolor=C_FOOT)
    table.cell(tbl, 1, 11, barStr,
               text_color=biasCol,   text_size=size.small, bgcolor=C_FOOT)
    table.cell(tbl, 2, 11, str.tostring(bullProb) + "% Bull",
               text_color=i_bullCol, text_size=size.tiny,  bgcolor=C_FOOT)

    // ── Row 12: Key Levels Header ─────────────────────────────────────────
    table.cell(tbl, 0, 12, "KEY LEVELS",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)
    table.cell(tbl, 1, 12, "",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)
    table.cell(tbl, 2, 12, "",
               text_color=color.gray, text_size=size.tiny, bgcolor=C_COLS)

    // ── Row 13: PDH / PD Mid / PDL ────────────────────────────────────────
    table.cell(tbl, 0, 13, "PDH  " + str.tostring(pdH,   format.mintick),
               text_color=color.new(#ef5350, 10), text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 1, 13, "PDM  " + str.tostring(pdMid, format.mintick),
               text_color=color.silver,            text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 2, 13, "PDL  " + str.tostring(pdL,   format.mintick),
               text_color=color.new(#26a69a, 10), text_size=size.tiny, bgcolor=C_FOOT)

    // ── Row 14: PD Open / PD Close / PD Range ────────────────────────────
    table.cell(tbl, 0, 14, "PDO  " + str.tostring(pdO,     format.mintick),
               text_color=color.yellow, text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 1, 14, "PDC  " + str.tostring(pdC,     format.mintick),
               text_color=color.white,  text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 2, 14, "PDR  " + str.tostring(pdRange, format.mintick),
               text_color=color.silver, text_size=size.tiny, bgcolor=C_FOOT)

    // ── Row 15: Today Open / OR High / OR Low ─────────────────────────────
    table.cell(tbl, 0, 15, "TodO " + str.tostring(todayOpen, format.mintick),
               text_color=color.yellow,            text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 1, 15, "ORH  " + str.tostring(orHigh,    format.mintick),
               text_color=color.new(#ffa726, 10), text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 2, 15, "ORL  " + str.tostring(orLow,     format.mintick),
               text_color=color.new(#42a5f5, 10), text_size=size.tiny, bgcolor=C_FOOT)

    // ── Row 16: VWAP / Fast EMA / Slow EMA ───────────────────────────────
    table.cell(tbl, 0, 16, "VWAP " + str.tostring(vwap,    format.mintick),
               text_color=color.new(#e91e63, 10), text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 1, 16, "EMA" + str.tostring(i_fastEMA) + "  " +
               str.tostring(fastEMA, format.mintick),
               text_color=color.new(#ffeb3b, 10), text_size=size.tiny, bgcolor=C_FOOT)
    table.cell(tbl, 2, 16, "EMA" + str.tostring(i_slowEMA) + "  " +
               str.tostring(slowEMA, format.mintick),
               text_color=color.new(#ff9800, 10), text_size=size.tiny, bgcolor=C_FOOT)
